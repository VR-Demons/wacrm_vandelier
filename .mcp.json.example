{
  "//": "EJEMPLO de MCP scoped al proyecto. Copia las entradas que necesites a .mcp.json (que arranca vacío) o usa `claude mcp add` (recomendado). Los ${VAR} se resuelven desde tu entorno / .env — NUNCA pongas tokens en claro aquí. Ver docs/mcp-setup.md.",

  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },

    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },

    "postman": {
      "command": "npx",
      "args": ["-y", "@postman/postman-mcp-server"],
      "env": {
        "POSTMAN_API_KEY": "${POSTMAN_API_KEY}",
        "POSTMAN_API_BASE_URL": "${POSTMAN_API_BASE_URL}"
      }
    },

    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "N8N_API_URL": "${N8N_API_URL}",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    }
  }
}
